{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["hostinger"],
  "permissions": {
    "additionalDirectories": ["../"],
    "allow": [
      "Bash(node .opencode/scripts/*)",
      "Bash(node */.opencode/scripts/*)",
      "Bash(npm install)",
      "Bash(npm run build)",
      "Bash(npx astro sync)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
